# Database Configuration (MySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=project_memory_db

# Hindsight Long-Term Memory Service
# Point to your running Hindsight server (e.g. Docker, self-hosted, or Hindsight Cloud)
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# Gemini AI Service (Google GenAI)
GEMINI_API_KEY=

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# CORS Configuration (allows frontend connection)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
